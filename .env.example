# Rutas locales. No incluya secretos en este archivo.
RAG_CORPUS_DIR=pb-src
RAG_DATA_DIR=rag-data
RAG_PBL_NAME=cotizador_mvp.pbl

# Modelo local de embeddings. Debe configurarse antes de indexar en modo real.
RAG_EMBED_PROVIDER=sentence-transformers
RAG_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_EMBED_DEVICE=cpu
# Mantiene tambien la descarga del modelo dentro de datos locales ignorados por Git.
HF_HOME=rag-data/model-cache

# El modo disabled mantiene parser, retrieval y citas operativos sin un LLM.
# Valores implementados: disabled, ollama, openai-compatible.
RAG_LLM_PROVIDER=disabled
RAG_LLM_MODEL=
RAG_LLM_BASE_URL=http://127.0.0.1:11434
RAG_LLM_API_KEY=

RAG_TOP_K=8
RAG_MAX_CONTEXT_CHARS=12000
